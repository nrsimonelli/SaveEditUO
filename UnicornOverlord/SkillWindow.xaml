<Window x:Class="UnicornOverlord.SkillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Skill" Height="360" Width="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <DockPanel>
        <!-- Filter bar -->
        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
            <Label Content="Filter" DockPanel.Dock="Left"/>
            <TextBox x:Name="TextBoxFilter"
                     TextChanged="TextBoxFilter_TextChanged"
                     TabIndex="0"/>
        </DockPanel>

        <!-- OK / Cancel -->
        <Grid DockPanel.Dock="Bottom" Margin="4,2,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ButtonOK"
                    Content="OK"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="ButtonOK_Click"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"/>
        </Grid>

        <!-- Skill list -->
        <ListBox x:Name="ListBoxSkill"
                 Margin="4,0"
                 SelectionChanged="ListBoxSkill_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8"
                                CornerRadius="4"
                                Margin="4,0,6,0"
                                VerticalAlignment="Center"
                                Background="{Binding BadgeColor}"/>
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
