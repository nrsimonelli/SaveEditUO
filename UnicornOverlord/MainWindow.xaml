<Window x:Class="UnicornOverlord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnicornOverlord"
		xmlns:prop="clr-namespace:UnicornOverlord.Properties"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="Unicorn Overlord(Nintendo Switch)" Height="500" Width="850">
	<Window.InputBindings>
		<KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileCommand}"/>
		<KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveFileCommand}"/>
		<KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsFileCommand}"/>
	</Window.InputBindings>
	<Window.Resources>
		<local:ClassIDConverter x:Key="ClassIDConverter"/>
		<local:ItemIDConverter x:Key="ItemIDConverter"/>
		<local:NameIDConverter x:Key="NameIDConverter"/>
		<local:GenericNameIDConverter x:Key="GenericNameIDConverter"/>
		<local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	</Window.Resources>
	<Window.DataContext>
		<local:ViewModel/>
	</Window.DataContext>
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="File(_F)">
				<MenuItem Header="Open(_O)" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
				<MenuItem Header="Save(_S)" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
				<MenuItem Header="SaveAs(_A)" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+Shift+S"/>
			</MenuItem>
		</Menu>
		<ToolBar DockPanel.Dock="Top">
			<Label Content="Language"/>
			<ComboBox Width="50" SelectedIndex="{Binding Source={x:Static prop:Settings.Default}, Path=Language}">
				<ComboBoxItem Content="en"/>
				<ComboBoxItem Content="jp"/>
				<ComboBoxItem Content="cn"/>
			</ComboBox>
		</ToolBar>
		<TabControl>
			<TabItem Header="Basic">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition/>
						<ColumnDefinition Width="5"/>
						<ColumnDefinition/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition Height="11*"/>
					</Grid.RowDefinitions>
					<Label Content="Money"/>
					<TextBox Grid.Column="1" Text="{Binding Basic.Money, UpdateSourceTrigger=PropertyChanged}"/>
					<Label Grid.Row="1" Content="Fame"/>
					<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Basic.Fame, UpdateSourceTrigger=PropertyChanged}"/>
					<Label Grid.Row="2" Content="ZENOIRA"/>
					<CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Basic.ZENOIRA}" VerticalAlignment="Center"/>
				</Grid>
			</TabItem>
			<TabItem Header="Character">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="200"/>
						<ColumnDefinition Width="220"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<DockPanel>
						<Grid DockPanel.Dock="Bottom">
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Button Content="Export"
									Command="{Binding ExportCharacterCommand}"
									CommandParameter="{Binding ElementName=ListBoxCharacter, Path=SelectedIndex}"/>
							<Button Grid.Column="1" Content="Import"
									Command="{Binding ImportCharacterCommand}"
									CommandParameter="{Binding ElementName=ListBoxCharacter, Path=SelectedIndex}"/>
							<Button Grid.Column="2" Content="Insert"
									Command="{Binding InsertCharacterCommand}"/>
						</Grid>
						<ListBox Name="ListBoxCharacter" ItemsSource="{Binding Characters}"
								 SelectedItem="{Binding SelectedCharacter}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Label Content="{Binding DisplayName}"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
					<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
							<RowDefinition MinHeight="24" MaxHeight="36"/>
						</Grid.RowDefinitions>
						<Label Content="Use"/>
						<CheckBox Grid.Column="1" IsChecked="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Use}" VerticalAlignment="Center"/>
						<Label Grid.Row="1" Content="Class"/>
						<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
							<Button Content=" ... "
									Command="{Binding ChoiceClassCommand}"
									CommandParameter="{Binding ElementName=ListBoxCharacter, Path=SelectedItem}"/>
							<Label Content="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Class, Converter={StaticResource ClassIDConverter}}"/>
						</StackPanel>
						<Label Grid.Row="2" Content="Lv"/>
						<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Lv, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="3" Content="Exp"/>
						<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Exp, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="4" Content="Growth 1"/>
						<ComboBox Grid.Row="4" Grid.Column="1"
								  SelectedIndex="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.GrowthType1, UpdateSourceTrigger=PropertyChanged}">
							<ComboBoxItem Content="None" IsEnabled="False"/>
							<ComboBoxItem Content="Hardy"/>
							<ComboBoxItem Content="Offensive"/>
							<ComboBoxItem Content="Defensive"/>
							<ComboBoxItem Content="Precise"/>
							<ComboBoxItem Content="Lucky"/>
							<ComboBoxItem Content="Keen"/>
							<ComboBoxItem Content="Guardian"/>
							<ComboBoxItem Content="Go-getter"/>
							<ComboBoxItem Content="All-rounder"/>
						</ComboBox>
						<Label Grid.Row="5" Content="Growth 2"/>
						<ComboBox Grid.Row="5" Grid.Column="1"
								  SelectedIndex="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.GrowthType2, UpdateSourceTrigger=PropertyChanged}">
							<ComboBoxItem Content="None" IsEnabled="False"/>
							<ComboBoxItem Content="Hardy"/>
							<ComboBoxItem Content="Offensive"/>
							<ComboBoxItem Content="Defensive"/>
							<ComboBoxItem Content="Precise"/>
							<ComboBoxItem Content="Lucky"/>
							<ComboBoxItem Content="Keen"/>
							<ComboBoxItem Content="Guardian"/>
							<ComboBoxItem Content="Go-getter"/>
							<ComboBoxItem Content="All-rounder"/>
						</ComboBox>
						<Label Grid.Row="6" Content="Gender"/>
						<ComboBox Grid.Row="6" Grid.Column="1"
								  SelectedIndex="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Gender, UpdateSourceTrigger=PropertyChanged, Converter={x:Static local:GenderIndexConverter.Instance}}">
							<ComboBoxItem Content="Male"/>
							<ComboBoxItem Content="Female"/>
						</ComboBox>
						<Label Grid.Row="7" Content="HPPlus"/>
						<TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.HPPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="8" Content="AttackPlus"/>
						<TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.AttackPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="9" Content="DefensePlus"/>
						<TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.DefensePlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="10" Content="MagicAttackPlus"/>
						<TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.MagicAttackPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="11" Content="MagicDefensePlus"/>
						<TextBox Grid.Row="11" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.MagicDefensePlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="12" Content="HitRatePlus"/>
						<TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.HitRatePlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="13" Content="AVoidPlus"/>
						<TextBox Grid.Row="13" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.AVoidPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="14" Content="CriticalPlus"/>
						<TextBox Grid.Row="14" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.CriticalPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="15" Content="GuardPlus"/>
						<TextBox Grid.Row="15" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.GuardPlus, UpdateSourceTrigger=PropertyChanged}"/>
						<Label Grid.Row="16" Content="SpeedPlus"/>
						<TextBox Grid.Row="16" Grid.Column="1" Text="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.SpeedPlus, UpdateSourceTrigger=PropertyChanged}"/>
					</Grid>
					</ScrollViewer>
					<TabControl Grid.Column="2">
						<TabItem Header="Equipment &amp; Skills">
							<!-- ── Equipment slots + Tactics in one scrollable panel ── -->
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel>

									<!-- Equipment slots -->
									<ListBox Name="ListBoxEquippedSlots" ItemsSource="{Binding EquippedSlots}"
											 HorizontalContentAlignment="Stretch"
											 BorderThickness="0">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<Grid IsEnabled="{Binding IsLocked, Converter={x:Static local:BoolInverter.Instance}}">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="45"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="50"/>
														<ColumnDefinition Width="50"/>
													</Grid.ColumnDefinitions>
													<Label Grid.Column="0" Content="{Binding SlotLabel}"/>
													<Label Grid.Column="1" Content="{Binding ItemName}"
														   Foreground="{Binding IsLocked, Converter={x:Static local:LockedBrushConverter.Instance}}"/>
													<Button Grid.Column="2" Content="Morph" HorizontalAlignment="Stretch"
															Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.MorphSlotCommand}"
															CommandParameter="{Binding}"
															IsEnabled="{Binding HasItem}"/>
													<Button Grid.Column="3" Content="Delete" HorizontalAlignment="Stretch"
															Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.DeleteSlotCommand}"
															CommandParameter="{Binding}"
															IsEnabled="{Binding HasItem}"/>
												</Grid>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>

									<!-- Create & Equip button -->
									<Button Content="Create &amp; Equip"
											Margin="4,4,4,2"
											Padding="8,3"
											Command="{Binding CreateAndEquipCommand}"
											CommandParameter="{Binding ElementName=ListBoxEquippedSlots, Path=SelectedItem}"
											IsEnabled="{Binding ElementName=ListBoxEquippedSlots, Path=SelectedItem.CanCreate, FallbackValue=False, TargetNullValue=False}"/>

									<!-- Separator -->
									<Separator Margin="4,2"/>

									<!-- Tactics header row -->
									<Grid Margin="2,4,2,1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="150"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="52"/>
										</Grid.ColumnDefinitions>
										<Label Grid.Column="0" Content="Action" FontWeight="SemiBold" Foreground="Gray" Padding="4,1" FontSize="11"/>
										<Label Grid.Column="1" Content="Condition 1" FontWeight="SemiBold" Foreground="Gray" Padding="4,1" FontSize="11"/>
										<Label Grid.Column="2" Content="Condition 2" FontWeight="SemiBold" Foreground="Gray" Padding="4,1" FontSize="11"/>
									</Grid>
									<Separator Margin="4,0,4,2"/>

									<!-- Tactic rows — one per non-empty entry (flat list) -->
									<ItemsControl ItemsSource="{Binding TacticEntries}"
												  HorizontalContentAlignment="Stretch">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
												<Grid Margin="2,2">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="150"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="52"/>
													</Grid.ColumnDefinitions>

													<!-- Col 0: [●] Skill name -->
													<StackPanel Grid.Column="0"
																Orientation="Horizontal"
																VerticalAlignment="Center">
														<Border Width="8" Height="8"
																CornerRadius="4"
																Margin="4,0,5,0"
																VerticalAlignment="Center"
																Background="{Binding BadgeColor}"/>
														<TextBlock Text="{Binding Action}"
																   FontFamily="Consolas"
																   FontSize="11"
																   VerticalAlignment="Center"
																   TextTrimming="CharacterEllipsis"/>
													</StackPanel>

													<!-- Col 1: Condition 1 - clickable -->
													<Button Grid.Column="1"
															Content="{Binding Condition1}"
															FontFamily="Consolas"
															FontSize="11"
															HorizontalContentAlignment="Left"
															Padding="4,1"
															Background="Transparent"
															BorderThickness="0"
															Foreground="Gray"
															Cursor="Hand"
															ToolTip="Click to change Condition 1"
															Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.EditCondition1Command}"
															CommandParameter="{Binding}"/>

													<!-- Col 2: Condition 2 - clickable -->
													<Button Grid.Column="2"
															Content="{Binding Condition2}"
															FontFamily="Consolas"
															FontSize="11"
															HorizontalContentAlignment="Left"
															Padding="4,1"
															Background="Transparent"
															BorderThickness="0"
															Foreground="Gray"
															Cursor="Hand"
															ToolTip="Click to change Condition 2"
															Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.EditCondition2Command}"
															CommandParameter="{Binding}"/>

													<!-- Col 3: Delete -->
													<Button Grid.Column="3"
															Content="Delete"
															FontSize="10"
															Padding="2,1"
															Margin="2,0,0,0"
															Visibility="{Binding IsDeletable, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
															ToolTip="Remove this skill slot"
															Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.DeleteTacticEntryCommand}"
															CommandParameter="{Binding}"/>
												</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!-- Add Skill button -->
									<Button Content="+ Add Skill"
											Margin="4,4,4,2"
											HorizontalAlignment="Stretch"
											Padding="8,3"
											IsEnabled="{Binding CanAddSkill}"
											ToolTip="Add a new skill to this character's tactics (max 8)"
											Command="{Binding AddSkillCommand}"/>

								</StackPanel>
							</ScrollViewer>
						</TabItem>
						<TabItem Header="Bond">
							<DockPanel>
								<Button DockPanel.Dock="Top" Content="Count Max"
										Command="{Binding ChangeCharacterBondMaxCommand}"
										CommandParameter="{Binding ElementName=ListBoxCharacter, Path=SelectedItem}"/>
								<ListBox ItemsSource="{Binding ElementName=ListBoxCharacter, Path=SelectedItem.Bonds}">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<Label Content="ID"/>
												<Label Content="{Binding ID}"/>
												<Label Content="Value"/>
												<TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</DockPanel>
						</TabItem>
					</TabControl>
				</Grid>
			</TabItem>
			<TabItem Header="Item">
				<DockPanel>
					<Button DockPanel.Dock="Bottom" Content="Append" Command="{Binding AppendItemCommand}"/>
					<Button DockPanel.Dock="Top" Content="Count Max" Command="{Binding ChangeItemCountMaxCommand}"/>
					<ListBox ItemsSource="{Binding Items}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<Label Content="Count"/>
									<TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
									<Button Content=" ... "
									Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.ChoiceItemCommand}"
									CommandParameter="{Binding}"/>
									<Label Content="{Binding ID, Converter={StaticResource ItemIDConverter}}"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</TabItem>
				<TabItem Header="Equipment">
				<DockPanel>
					<Button DockPanel.Dock="Bottom" Content="Append" Command="{Binding AppendEquipmentCommand}"/>
					<ListBox ItemsSource="{Binding Equipments}" HorizontalContentAlignment="Stretch">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="40"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="40"/>
										<ColumnDefinition Width="30"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="55"/>
									</Grid.ColumnDefinitions>
									<Label Grid.Column="0" Content="???1"/>
									<Label Grid.Column="1" Content="{Binding Equipment1}"/>
									<Label Grid.Column="2" Content="???2"/>
									<Label Grid.Column="3" Content="{Binding Equipment2}"/>
									<Button Grid.Column="4" Content=" ... "
											Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.ChoiceEquipmentCommand}"
											CommandParameter="{Binding}"/>
									<Label Grid.Column="5" Content="{Binding ID, Converter={StaticResource ItemIDConverter}}"/>
									<Button Grid.Column="6" Content="Delete" HorizontalAlignment="Stretch"
											Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}, Path=DataContext.DeleteEquipmentCommand}"
											CommandParameter="{Binding}"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</TabItem>
			<TabItem Header="Unit">
				<ListBox ItemsSource="{Binding Units}" d:ItemsSource="{d:SampleData}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<Label Content="Valid"/>
								<CheckBox IsChecked="{Binding Valid}" VerticalAlignment="Center"/>
								<Label Content="Count"/>
								<TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
